# SiliconFlow: backend only. Copy to .env and configure private values locally.
SILICONFLOW_API_KEY=
# Internal review: FastAPI only; never pass this value to frontend build/runtime.
REVIEW_ADMIN_TOKEN=

# Experimental automatic injection; extraction/storage still run after success.
ENABLE_LONG_TERM_MEMORY_INJECTION=false

# PostgreSQL / Compose initialization (no real credentials in this example).
POSTGRES_USER=roborock_app
POSTGRES_PASSWORD=
# Use a URL-encoded password matching POSTGRES_PASSWORD.
# Compose connects to postgres:5432; local Python uses 127.0.0.1:5433 instead.
DATABASE_URL=postgresql+psycopg://roborock_app:REPLACE_WITH_URL_ENCODED_PASSWORD@postgres:5432/roborock
# Host ports are bound to 127.0.0.1. Frontend is the normal browser entry point.
POSTGRES_HOST_PORT=5433
API_HOST_PORT=8000
FRONTEND_HOST_PORT=8080
# Frontend production uses relative URLs; no VITE_ secrets or internal API URL.
# VITE_API_BASE_URL is intentionally unset (empty in frontend Docker build).
# On Docker Desktop versions with non-ASCII BuildKit session errors,
# place the project/build context in an ASCII-only directory.
